{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "schedule:weekly"],
  ignorePresets: [":pinDevDependencies", ":maintainLockFilesWeekly"],
  timezone: "Asia/Seoul",
  dependencyDashboard: {
    enabled: true,
  },
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: "7 days",
  },
  platformAutomerge: true,
  automergeType: "pr",
  packageRules: [
    {
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "7 days",
      internalChecksFilter: "strict",
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "npm minor and patch",
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch"],
      groupName: "npm patch and dev minor",
      automerge: true,
    },
    {
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "npm patch and dev minor",
      automerge: true,
    },
    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
    },
    {
      matchFileNames: ["packages/wallet-core/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "wallet-core minor and patch",
      automerge: false,
    },
    {
      matchPackageNames: ["@noble/*", "@scure/*"],
      groupName: "noble and scure",
      automerge: false,
    },
    {
      matchPackageNames: ["viem", "@vaultme/*"],
      automerge: false,
    },
    {
      matchPackageNames: [
        "expo",
        "expo-*",
        "@expo/*",
        "react",
        "react-dom",
        "react-native",
        "react-native-*",
      ],
      enabled: false,
    },
  ],
}
