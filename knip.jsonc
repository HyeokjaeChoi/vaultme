{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Private monorepo, nothing is published: an entry export that no workspace imports is dead too (the unused reduce() in wallet-core was one).
  "includeEntryExports": true,
  // work/ and spikes are design and research scratch, .claude/ is agent tooling, design-md.d.mts types a .mjs script.
  "ignore": ["work/**", "scripts/spikes/**", ".claude/**", "packages/tokens/design-md.d.mts"],
  // Run as binaries from .githooks/ and lint-staged.config.mjs, which knip does not read.
  "ignoreDependencies": ["eslint", "lint-staged"],
  "workspaces": {
    ".": { "entry": ["scripts/*.mjs"] },
    "apps/api": {
      // The vitest plugin cannot load this config from the repo root (readD1Migrations reads ./migrations).
      "vitest": false,
      "entry": [
        "vitest.config.ts",
        "vitest.reorg.config.ts",
        "reorg-setup.ts",
        "test/**/*.test.ts",
        "test-reorg/**/*.test.ts",
        "test/setup.ts",
      ],
      // `cloudflare:workers` is a runtime module, not a package.
      "ignoreDependencies": ["cloudflare"],
      // `anvil` (Foundry) is spawned by reorg-setup.ts; CI installs it (ci.yml).
      "ignoreBinaries": ["anvil"],
    },
    // Run by k6 (api-bench.yml), not by Node: its `k6/*` imports are k6 built-in modules.
    "packages/perf": { "entry": ["k6/api.js"], "ignoreDependencies": ["k6"] },
    // Fixture app of test/build.test.ts: built by React Router, imported by nobody.
    "apps/web": { "entry": ["steiger.config.mjs"], "ignore": ["test/fixtures/**"] },
    "apps/mobile": {
      "entry": ["steiger.config.mjs"],
      // Guessed from app.json: no OTA updates are used.
      "ignoreDependencies": ["expo-updates"],
    },
  },
}
