{
  "name": "vaultme",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "knip": "knip --include files,dependencies,unlisted,unresolved,binaries",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "knip": "6.42.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
