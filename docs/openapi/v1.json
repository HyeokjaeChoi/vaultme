{
  "openapi": "3.1.0",
  "info": {
    "title": "VaultMe API",
    "version": "v1"
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "version"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_cursor",
              "origin_forbidden",
              "method_not_allowed",
              "unauthorized",
              "signature_invalid",
              "nonce_reused",
              "clock_skew",
              "not_found",
              "update_required",
              "rate_limited",
              "internal",
              "unavailable"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "installId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "installId"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string",
            "minLength": 87,
            "maxLength": 87,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "publicKey"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "InstallMeResponse": {
        "type": "object",
        "properties": {
          "installId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "installId"
        ]
      },
      "RpcResponse": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {},
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "number"
              },
              "message": {
                "type": "string"
              },
              "data": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "jsonrpc",
          "id"
        ]
      },
      "RpcRequest": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "type": "string",
            "maxLength": 64
          },
          "params": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "jsonrpc",
          "id",
          "method"
        ]
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "maxItems": 50,
            "description": "Newest first."
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null on the last page."
          },
          "incomplete": {
            "type": "boolean",
            "description": "One block had more rows than the server can read for one address. Its rows are missing; `nextCursor` continues below it."
          }
        },
        "required": [
          "items",
          "nextCursor",
          "incomplete"
        ]
      },
      "HistoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique within a response: `<hash>:<seq>`."
          },
          "kind": {
            "type": "string",
            "enum": [
              "native",
              "internal",
              "erc20"
            ]
          },
          "hash": {
            "type": "string"
          },
          "blockNumber": {
            "type": "integer",
            "minimum": 0
          },
          "txIndex": {
            "type": "integer",
            "minimum": 0
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix seconds."
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ],
            "description": "Relative to the address. A transfer to itself is `out`, except that a zero-value erc20 row is `out` only if the tx sender is the address (#53)."
          },
          "asset": {
            "type": "string",
            "enum": [
              "ETH",
              "USDC"
            ]
          },
          "value": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Raw units (wei, or USDC with 6 decimals), decimal string."
          },
          "from": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "to": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "Null for a contract creation."
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed"
            ],
            "description": "`failed`: the value did not move."
          },
          "zeroValue": {
            "type": "boolean",
            "description": "value is 0 (contract call, or an address-poisoning transfer, Q71)."
          }
        },
        "required": [
          "id",
          "kind",
          "hash",
          "blockNumber",
          "txIndex",
          "timestamp",
          "direction",
          "asset",
          "value",
          "from",
          "to",
          "status",
          "zeroValue"
        ]
      },
      "HistoryRequest": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "cursor": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "address"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "responses": {
          "200": {
            "description": "API is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "403": {
            "description": "Request had an Origin header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/installs": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Install registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid public key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/installs/token": {
      "post": {
        "responses": {
          "200": {
            "description": "Short-lived token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid signed-request headers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/installs/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Token is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallMeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rpc": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upstream JSON-RPC response, errors included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcResponse"
                }
              }
            }
          },
          "400": {
            "description": "Not a single JSON-RPC 2.0 request (batches are not supported)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Method or eth_call target not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Both upstreams failed (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One page of history, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid address or cursor (`invalid_cursor`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Etherscan failed or was throttled (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
