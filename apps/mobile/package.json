{
  "name": "@vaultme/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "generate:licenses": "node scripts/generate-licenses.mjs",
    "start": "node scripts/generate-licenses.mjs && expo start",
    "ios": "node scripts/generate-licenses.mjs && expo run:ios",
    "android": "node scripts/generate-licenses.mjs && expo run:android",
    "export": "node scripts/generate-licenses.mjs && expo export --platform ios",
    "test": "node scripts/generate-licenses.mjs && vitest run --passWithNoTests",
    "typecheck": "node scripts/generate-licenses.mjs && tsc -p tsconfig.json",
    "lint": "node scripts/generate-licenses.mjs && eslint ."
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@solar-icons/react-native": "2.3.2",
    "@vaultme/contracts": "workspace:*",
    "@vaultme/i18n": "workspace:*",
    "@vaultme/tokens": "workspace:*",
    "@vaultme/wallet-core": "workspace:*",
    "expo": "~57.0.0",
    "expo-build-properties": "57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.0",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.0",
    "expo-screen-capture": "~57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "~57.0.0",
    "i18next": "^26.0.2",
    "pretendard": "1.3.9",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.0",
    "react-native": "0.86.3",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "@vaultme/config": "workspace:*",
    "eslint": "^10.12.0",
    "jsqr": "1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
