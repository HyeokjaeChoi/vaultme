{
  "name": "@vaultme/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "generate:licenses": "node scripts/generate-licenses.mjs",
    "start": "node scripts/generate-licenses.mjs && expo start",
    "ios": "node scripts/generate-licenses.mjs && expo run:ios",
    "android": "node scripts/generate-licenses.mjs && expo run:android",
    "export": "node scripts/generate-licenses.mjs && expo export --platform ios",
    "test": "node scripts/generate-licenses.mjs && vitest run --passWithNoTests",
    "typecheck": "node scripts/generate-licenses.mjs && tsc -p tsconfig.json",
    "lint": "node scripts/generate-licenses.mjs && eslint . --max-warnings=0 && steiger ./src",
    "export:check": "node scripts/generate-licenses.mjs && expo export --platform ios --platform android --output-dir dist",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@solar-icons/react-native": "2.3.2",
    "@vaultme/contracts": "workspace:*",
    "@vaultme/i18n": "workspace:*",
    "@vaultme/tokens": "workspace:*",
    "@vaultme/wallet-core": "workspace:*",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-screen-capture": "~58.0.5",
    "expo-splash-screen": "58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.0.2",
    "pretendard": "1.3.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-i18next": "^17.0.0",
    "react-native": "0.88.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@vaultme/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-unicorn": "78.0.0",
    "expo-doctor": "1.21.5",
    "jsqr": "1.4.0",
    "steiger": "0.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
