{
  // Full file name: since SDK 58 `expo` has an `exports` map, and Vite (vitest) cannot resolve the extensionless `expo/tsconfig.base` through it.
  // Go back to the extensionless form when vitest resolves it.
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
