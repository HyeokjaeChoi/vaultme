{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://vaultme-api-staging.gurwo1007.workers.dev",
        "EXPO_PUBLIC_ENV": "staging"
      }
    },
    "release-staging": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://vaultme-api-staging.gurwo1007.workers.dev",
        "EXPO_PUBLIC_ENV": "staging"
      }
    }
  }
}
