{
  "expo": {
    "name": "VaultMe",
    "slug": "vaultme",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "vaultme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.stackline.vaultme",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "지갑을 열고 거래에 서명할 때 Face ID를 사용해요."
      }
    },
    "android": {
      "package": "dev.stackline.vaultme",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "permissions": ["android.permission.USE_BIOMETRIC"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#3152FF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "받는 주소 QR을 스캔할 때 카메라를 사용해요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#11161D"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "stackline-i7",
          "project": "vaultme-mobile",
          "url": "https://sentry.io/",
          "disableAutoUpload": true
        }
      ],
      "expo-dev-client",
      "expo-font",
      "expo-status-bar",
      "expo-system-ui",
      ["expo-navigation-bar", { "enforceContrast": false }]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "sentryDsn": "https://829cd162f8ca5ed48b82a1148baa75d4@o4512355457433600.ingest.us.sentry.io/4512355516940288",
      "eas": {
        "projectId": "ebb84cd1-35eb-4aca-9702-cf1a03faa4b5"
      }
    },
    "owner": "gurwo1007"
  }
}
