# Android permissions the app may request (SEC-11, read by test/native-config.test.ts; SEC-6 compares the merged APK to this file).
# One name per line. A new permission needs a line here in the same PR, with the reason after the name.
android.permission.USE_BIOMETRIC       # app.json: unlock and sign with fingerprint or face
android.permission.USE_FINGERPRINT     # expo-local-authentication legacy pair of USE_BIOMETRIC (API < 28)
android.permission.CAMERA              # expo-camera: scan the recipient QR
android.permission.INTERNET            # API and RPC calls
android.permission.READ_EXTERNAL_STORAGE   # added by a config plugin today; remove when the plugin stops adding it
android.permission.WRITE_EXTERNAL_STORAGE  # same
