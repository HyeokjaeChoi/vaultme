{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaultme-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  // nodejs_als: AsyncLocalStorage for the request id in logs (src/log.ts) and for @sentry/cloudflare. Inherited by the envs.
  "compatibility_flags": ["nodejs_als"],
  // vars only. No account IDs, no secrets here. Secrets go in `.dev.vars` (local) or `wrangler secret` (deployed).
  // Vars and bindings are not inherited by named environments, so each env repeats them.
  // WEB_ORIGINS: comma-separated browser origins the API allows (ADR-0011). Empty at the top level (local dev, tests): no browser.
  // ENVIRONMENT: dev | staging | production; the Sentry environment, and only `dev` serves /v1/debug/sentry (ARCHITECTURE.md#observability).
  // SENTRY_DSN (Q50) is a plain var, not a secret: a Sentry DSN only allows sending events and gives no read access, so it is safe to keep public
  // (https://docs.sentry.io/concepts/key-terms/dsn-explainer/, "DSN Utilization"). Project vaultme-api. An empty value turns Sentry off (tests).
  "vars": {
    "MIN_APP_VERSION": "0.0.0",
    "MIN_WEB_VERSION": "0.0.0",
    "WEB_ORIGINS": "",
    "ENVIRONMENT": "dev",
    "SENTRY_DSN": "https://d539efbe04f78c6b05458cd5f7133138@o4512355457433600.ingest.us.sentry.io/4512355519102976",
  },
  // Workers Analytics Engine (Q56): request, push latency and push ticket/receipt data points (src/metrics.ts). One dataset per env.
  // The dataset is created on the first write. Reading it needs a Cloudflare API token with Account Analytics read (owner).
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "vaultme_api" }],
  // ETHERSCAN_API_KEY (history upstream) is a secret too. The EtherscanBucket Durable Object is one global token bucket (ARCHITECTURE.md#history).
  // ALCHEMY_WEBHOOK_ID, ALCHEMY_SIGNING_KEY, ALCHEMY_NOTIFY_TOKEN, EXPO_ACCESS_TOKEN (transaction push, #67) are secrets too.
  // INFURA_KEY and ALCHEMY_KEY (RPC upstreams) are secrets too, set the same way.
  // TOKEN_SECRET (>= 32 chars) is a secret: .dev.vars locally, `wrangler secret put TOKEN_SECRET` when deployed.
  // database_id is left out so wrangler provisions the D1 database on first deploy. Local dev needs none.
  "durable_objects": { "bindings": [{ "name": "ETHERSCAN_BUCKET", "class_name": "EtherscanBucket" }] },
  // Hourly sweep for transaction push (#67): 30-day expiry, Alchemy removal retries, Expo receipts (#314).
  "triggers": { "crons": ["17 * * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EtherscanBucket"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "vaultme-api", "migrations_dir": "migrations" }],
  // Cloudflare limits count per location and are approximate (ARCHITECTURE.md#invariants, rate limits). period is 10 or 60 only.
  // namespace_id is account-wide: each env needs its own ids (1xxx top level, 2xxx staging, 3xxx production).
  "ratelimits": [
    { "name": "INSTALL_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "INSTALL_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RPC_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
    { "name": "HISTORY_IP_LIMITER", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
  ],
  "env": {
    "staging": {
      "name": "vaultme-api-staging",
      // Workers Logs (#183): per-request logs and console output, kept by Cloudflare. Staging only.
      "observability": { "enabled": true },
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "MIN_APP_VERSION": "0.0.0",
        "MIN_WEB_VERSION": "0.0.0",
        "WEB_ORIGINS": "https://vaultme-staging.stack-line.dev",
        "ENVIRONMENT": "staging",
        "SENTRY_DSN": "https://d539efbe04f78c6b05458cd5f7133138@o4512355457433600.ingest.us.sentry.io/4512355519102976",
      },
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "vaultme_api_staging" }],
      "durable_objects": { "bindings": [{ "name": "ETHERSCAN_BUCKET", "class_name": "EtherscanBucket" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EtherscanBucket"] }],
      "d1_databases": [{ "binding": "DB", "database_name": "vaultme-api-staging", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "INSTALL_IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
        { "name": "INSTALL_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RPC_IP_LIMITER", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } },
        { "name": "HISTORY_IP_LIMITER", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } },
      ],
    },
    "production": {
      "name": "vaultme-api-production",
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "MIN_APP_VERSION": "0.0.0",
        "MIN_WEB_VERSION": "0.0.0",
        "WEB_ORIGINS": "https://vaultme.stack-line.dev",
        "ENVIRONMENT": "production",
        "SENTRY_DSN": "https://d539efbe04f78c6b05458cd5f7133138@o4512355457433600.ingest.us.sentry.io/4512355519102976",
      },
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "vaultme_api_production" }],
      "durable_objects": { "bindings": [{ "name": "ETHERSCAN_BUCKET", "class_name": "EtherscanBucket" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EtherscanBucket"] }],
      "d1_databases": [{ "binding": "DB", "database_name": "vaultme-api-production", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "INSTALL_IP_LIMITER", "namespace_id": "3001", "simple": { "limit": 3, "period": 60 } },
        { "name": "INSTALL_LIMITER", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RPC_IP_LIMITER", "namespace_id": "3003", "simple": { "limit": 300, "period": 60 } },
        { "name": "HISTORY_IP_LIMITER", "namespace_id": "3004", "simple": { "limit": 300, "period": 60 } },
      ],
    },
  },
}
