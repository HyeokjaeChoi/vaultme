{
  "name": "@vaultme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "openapi": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "@vaultme/contracts": "workspace:*",
    "hono": "^4.13.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@types/node": "^24.19.1",
    "@vaultme/config": "workspace:*",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "4.151.1"
  }
