{
  "name": "@vaultme/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/finalize.ts",
    "preview": "wrangler dev",
    "typegen": "react-router typegen",
    "test": "react-router typegen && vitest run",
    "test:e2e": "playwright test",
    "lhci": "pnpm lhci:desktop && pnpm lhci:mobile",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json; a=$?; node scripts/js-budget.ts; b=$?; test $a -eq 0 -a $b -eq 0",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json; a=$?; node scripts/js-budget.ts; b=$?; test $a -eq 0 -a $b -eq 0",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "lint:css": "stylelint \"app/**/*.css\" --max-warnings=0",
    "lint": "eslint . --max-warnings=0 && steiger ./app && pnpm lint:css"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "@vaultme/api-client": "workspace:*",
    "@vaultme/history": "workspace:*",
    "@vaultme/i18n": "workspace:*",
    "@vaultme/tokens": "workspace:*",
    "@vaultme/wallet-core": "workspace:*",
    "isbot": "^5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vaultme/config": "workspace:*",
    "@vaultme/contracts": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "pretendard": "1.3.9",
    "steiger": "0.8.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "4.152.0"
  }
}
