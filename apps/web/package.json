{
  "name": "@vaultme/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/finalize.ts",
    "preview": "wrangler dev",
    "typegen": "react-router typegen",
    "test": "react-router typegen && vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.desktop.json && lhci autorun --config=lighthouserc.mobile.json",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@vaultme/i18n": "workspace:*",
    "@vaultme/tokens": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vaultme/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "pretendard": "1.3.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "4.151.1"
  }
}
