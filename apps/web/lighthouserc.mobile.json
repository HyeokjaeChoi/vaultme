{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec wrangler dev --env staging --port 8799",
      "startServerReadyPattern": "Ready on",
      "url": [
        "http://localhost:8799/",
        "http://localhost:8799/en/",
        "http://localhost:8799/no-such-page",
        "http://localhost:8799/en/no-such-page",
        "http://localhost:8799/address",
        "http://localhost:8799/en/address",
        "http://localhost:8799/tx",
        "http://localhost:8799/en/tx"
      ],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "ignoreStatusCode": true,
        "skipAudits": ["is-crawlable", "http-status-code"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:8799/(en/)?(no-such-page)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:8799/(en/)?(address|tx)",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ]
          }
        }
      ]
    }
  }
}
